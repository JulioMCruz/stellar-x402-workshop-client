# STELLAR X402 WORKSHOP CLIENT — TESTNET
#
# Browser setup:
#   npm ci
#   npm run setup
#   npm run preflight
#   npm run check
#   npm run dev
#
# The separate server must already be running on port 3000.

# Public URL of the separately deployed workshop server.
NEXT_PUBLIC_API_URL=http://localhost:3000

# Must match the server network. The workshop uses only Testnet.
NEXT_PUBLIC_STELLAR_NETWORK=stellar:testnet

# OPTIONAL: used by `npm run agent:wallet` and `npm run agent:pay` only.
# The browser flow signs with Freighter and does not use this value.
#
# Create and fund a disposable payer with Testnet XLM:
#   stellar keys generate workshop-payer --network testnet --fund --secure-store
#   stellar keys address workshop-payer
#
# Allow it to hold Testnet USDC:
#   stellar tx new change-trust --network testnet --source-account workshop-payer --line USDC:GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5 --limit 1000000
#
# Request Testnet USDC for its public G-address at https://faucet.circle.com.
# Retrieve the S-secret only when configuring the local agent:
#   stellar keys secret workshop-payer
#
# Never commit this value, print it during a presentation, paste it into chat,
# or expose it through a NEXT_PUBLIC_ variable.
STELLAR_PRIVATE_KEY=S_REPLACE_WITH_TESTNET_SECRET
