{
  "name": "stellar-x402-workshop-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "preflight": "node --env-file=.env.local scripts/preflight.mjs",
    "preflight:agent": "node --env-file=.env.local scripts/preflight.mjs --agent",
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "lint": "eslint .",
    "test": "vitest run",
    "agent": "tsx scripts/agent-client.ts",
    "check": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@stellar/freighter-api": "6.0.1",
    "@x402/fetch": "2.22.0",
    "@x402/stellar": "2.22.0",
    "dotenv": "^17.0.0",
    "next": "16.3.0",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.0",
    "tsx": "^4.20.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
